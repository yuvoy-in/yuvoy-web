# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing / e2e
/playwright-report
/playwright/.cache
/test-results

# storybook
/storybook-static

# backend reference clone (read-only; never track or push)
/yuvoy-api

# Agent worktrees are whole checkouts; never part of this repo.
.claude/worktrees/

# Agent session notes. Written by a local plugin, not by anyone reviewing this
# repo, and they summarise whatever the machine was doing at the time — local
# paths, tooling outside this project, and details of an environment that has
# nothing to do with Yuvoy. That is not repository content, and a private repo
# is not a reason to publish it.
#
# Untracked on 2026-08-08 (owner direction). The eight files already in history
# stay there; removing them from the tip does not remove them from the log, so
# this stops the leak growing rather than undoing it.
/.memsearch/
